generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
}

enum DocType {
  RAHUNOK
  NAKLADNA
}

enum DocStatus {
  ACTIVE
  ANNULLED
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  role         Role     @default(manager)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  documents Document[]
  versions  DocumentVersion[]
}

/// Наш ФОП (постачальник)
model OurFop {
  id               Int     @id @default(autoincrement())
  sdOrganizationId Int?    @unique
  name             String
  /// Многострочные реквизиты для шапки документа
  requisites       String  @db.Text
  phone            String  @default("")
  isDefault        Boolean @default(false)
  /// hidden from the supplier choice; kept because documents and the rahunok counter refer to it
  archived         Boolean @default(false)

  counters  InvoiceCounter[]
  documents Document[]
}

/// Клиент (справочник «Клієнти»): один или несколько ФОП-получателей
model Client {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  comment   String   @default("")
  createdAt DateTime @default(now())

  fops ClientFop[]
}

/// ФОП клиента (одержувач документа)
model ClientFop {
  id         Int     @id @default(autoincrement())
  clientId   Int
  name       String
  requisites String  @db.Text
  archived   Boolean @default(false)

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents Document[]
  defaults  ContactDefault[]

  @@index([clientId])
}

/// Последний выбранный ФОП получателя для контакта SalesDrive (подставляется по умолчанию)
model ContactDefault {
  sdContactId Int      @id
  clientFopId Int
  updatedAt   DateTime @updatedAt

  clientFop ClientFop @relation(fields: [clientFopId], references: [id], onDelete: Cascade)
}

/// Счётчик номеров рахунків: (наш ФОП × год × месяц)
model InvoiceCounter {
  fopId Int
  year  Int
  month Int
  last  Int

  fop OurFop @relation(fields: [fopId], references: [id])

  @@id([fopId, year, month])
}

model Document {
  id          Int       @id @default(autoincrement())
  type        DocType
  number      Int
  date        DateTime  @db.Date
  fopId       Int
  /// null after the recipient client/FOP was deleted; the recipient text stays in DocumentVersion.headerJson
  clientFopId Int?
  sdOrderId   Int
  status      DocStatus @default(ACTIVE)
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fop       OurFop            @relation(fields: [fopId], references: [id])
  clientFop ClientFop?        @relation(fields: [clientFopId], references: [id], onDelete: SetNull)
  createdBy User              @relation(fields: [createdById], references: [id])
  versions  DocumentVersion[]

  /// At most one ACTIVE document per (type, order): partial unique index "Document_active_type_order"
  /// is created by raw SQL in migration 2026…_reissue_after_annul (Prisma 6 can't express partial indexes).
  /// ⚠ If a future `prisma migrate dev` proposes `DROP INDEX "Document_active_type_order"`, remove that line from the migration.
  @@index([type, sdOrderId])
  @@index([date])
}

/// Снимок строк документа (после разбивки «Мікс»); файл пересобирается из последнего снимка
model DocumentVersion {
  id          Int      @id @default(autoincrement())
  documentId  Int
  linesJson   Json
  totalsJson  Json
  headerJson  Json
  createdAt   DateTime @default(now())
  createdById Int

  document  Document @relation(fields: [documentId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([documentId])
}
